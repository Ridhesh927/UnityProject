# Unity Monorepo .gitignore
# Ignores Unity generated and temporary directories across all subprojects

**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Blender backup files
*.blend1
*.blend1.meta

# Visual Studio / Rider / IDE cache
**/.vs/
**/.gradle/
**/ExportedObj/
**/.consulo/
*.DotSettings.user
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports & system files
sysinfo.txt
*.log
.DS_Store
[Tt]humbs.db

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
